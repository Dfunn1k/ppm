# Configuración de PPM en producción. Cópialo a la raíz del repo como .env y llénalo:
#   cp deploy/.env.example .env && chmod 600 .env
# .env nunca se sube a git.

# El dominio (sin https://). Su DNS (registro A) debe apuntar a la IP de la VPS antes de levantar.
PPM_DOMAIN=ppm.ejemplo.com

# Contraseña de PostgreSQL. Solo letras y números (va dentro de una URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Correo saliente (recuperar contraseña). Cualquier proveedor SMTP con STARTTLS en el puerto 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=PPM <no-responder@ppm.ejemplo.com>

# Quienes ven Z1 (tipo de cambio), separados por coma. Entran con una cuenta normal de PPM con ese correo.
ADMIN_EMAILS=
